# Copy to .env and set values locally. A local .env.txt is also supported.
GEMINI_API_KEY=
SNART_DATABASE=data/snart.sqlite3
SNART_NEARBY_RADIUS_M=150
SNART_MAX_GPS_ACCURACY_M=100
SNART_MAX_PHOTO_BYTES=8388608
SNART_MODEL_PROVIDER=gemini
SNART_MODEL_ID=gemini-3.5-flash-lite
SNART_MODEL_TIMEOUT_SECONDS=15
